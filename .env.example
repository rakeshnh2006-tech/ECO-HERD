# ─── IBM WatsonX (Granite 4) ───────────────────────────────────────────────
# Falls back to OpenRouter ibm-granite/granite-4.2-8b if WatsonX project 403
IBM_API_KEY=your-ibm-api-key-here
IBM_PROJECT_ID=your-ibm-project-id-here
IBM_URL=https://us-south.ml.cloud.ibm.com

# ─── Gemini (via OpenRouter) ───────────────────────────────────────────────
# Use an OpenRouter key (sk-or-v1-...) — routes to google/gemini-2.5-flash
GEMINI_API_KEY=your-openrouter-key-here

# ─── Groq ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ─── OmniRoute LLM Gateway (optional) ─────────────────────────────────────
# If not set, gateway falls back directly to provider adapters
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=https://omniroute.online/v1

# ─── Google Maps ───────────────────────────────────────────────────────────
# Maps JavaScript API key — enables satellite tiles in the dashboard
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ─── HITL threshold ────────────────────────────────────────────────────────
# Detections below this confidence are flagged for manual review (0.0–1.0)
HITL_CONFIDENCE_THRESHOLD=0.70
